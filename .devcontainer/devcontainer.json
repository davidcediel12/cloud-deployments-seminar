{
  "name": "Cloud Seminar",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/go:1": { "version": "1.26" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "helm": "none", "minikube": "none" },
    "ghcr.io/devcontainers/features/terraform:1": {}
  },
  "forwardPorts": [8081, 5173],
  "portsAttributes": {
    "8081": { "label": "API" },
    "5173": { "label": "Web (Vite dev)" }
  },
  "postCreateCommand": "cd web && npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "ms-azuretools.vscode-docker"]
    }
  }
}
