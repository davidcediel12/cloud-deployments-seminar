{
  "uid": "seminar-api",
  "title": "Seminar API",
  "description": "Requests, errors, latency, a custom metric, logs and traces of the seminar API.",
  "tags": ["seminar"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second, by route",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{service_name=\"seminar-api\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Responses per second, by status code",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"seminar-api\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency (p50, p95)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"seminar-api\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"seminar-api\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Notes created (in the time range)",
      "description": "Custom metric: the notes.created counter in api/notes.go.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(notes_created_total{service_name=\"seminar-api\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs",
      "description": "The API logs the message \"request\" with method, path, status and duration as separate fields; line_format puts them in the line. Expand a line to see all fields, including trace_id.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"seminar-api\"} | line_format `{{ if .path }}{{ .method }} {{ .path }} -> {{ .status }} ({{ .duration_ms }} ms){{ else }}{{ __line__ }}{{ end }}`"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent traces (click a trace ID)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"seminar-api\"}",
          "limit": 20
        }
      ]
    }
  ]
}
